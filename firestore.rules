rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128;
    }

    match /receipts/{receiptId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(receiptId);
    }

    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(settingId);
    }

    match /staff/{staffId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(staffId);
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
